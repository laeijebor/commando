#!/usr/bin/env bash
# Installs (or updates) every agent skill in skills/ into the harness skill
# directories that should have them. Safe to rerun after editing a canonical
# copy at skills/<name>/SKILL.md.
set -euo pipefail

skills_root="$(cd "$(dirname "$0")/../skills" && pwd)"

destination_roots=(
  "$HOME/.claude/skills"
  "$HOME/.claudep/skills"
  "$HOME/.claudey/skills"
  "$HOME/.config/opencode/skills"
)

for skill_dir in "$skills_root"/*/; do
  name="$(basename "$skill_dir")"
  [ -f "$skill_dir/SKILL.md" ] || continue
  for root in "${destination_roots[@]}"; do
    mkdir -p "$root/$name"
    cp "$skill_dir/SKILL.md" "$root/$name/SKILL.md"
    echo "installed $root/$name/SKILL.md"
  done
done
