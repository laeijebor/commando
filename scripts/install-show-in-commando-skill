#!/usr/bin/env bash
# Installs (or updates) every agent skill in skills/ into the harness skill
# directories that should have them. Safe to rerun after editing a canonical
# copy at skills/<name>/SKILL.md.
set -euo pipefail

skills_root="$(cd "$(dirname "$0")/../skills" && pwd)"
# Installed copies live outside the checkout, so skills name its scripts by
# {{COMMANDO_REPO}} and each copy gets this checkout's absolute path.
repo_root="$(cd "$skills_root/.." && pwd)"

destination_roots=(
  "$HOME/.claude/skills"
  "$HOME/.claudep/skills"
  "$HOME/.claudew/skills"
  "$HOME/.claudey/skills"
  "$HOME/.cursor/skills"
  "$HOME/.config/opencode/skills"
  "$HOME/.codex/skills"
)
# Custom Claude profiles may intentionally live outside HOME. Test callers must
# clear inherited CLAUDE_CONFIG_DIR before invoking this installer in a sandbox.
if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
  destination_roots+=("$CLAUDE_CONFIG_DIR/skills")
fi
# Muse reads native skills from its config folder, ahead of the Claude copies it
# also imports. Only install there once Muse has created that folder.
muse_config="${XDG_CONFIG_HOME:-$HOME/.config}/muse"
if [ -d "$muse_config" ]; then
  destination_roots+=("$muse_config/skills")
fi

skill_dirs=("$skills_root"/*/)
if [ "$#" -gt 0 ]; then
  skill_dirs=()
  for name in "$@"; do
    if [[ ! "$name" =~ ^[a-z0-9-]+$ ]] || [ ! -f "$skills_root/$name/SKILL.md" ]; then
      echo "Unknown Commando skill: $name" >&2
      exit 1
    fi
    skill_dirs+=("$skills_root/$name/")
  done
fi

for skill_dir in "${skill_dirs[@]}"; do
  name="$(basename "$skill_dir")"
  [ -f "$skill_dir/SKILL.md" ] || continue
  for root in "${destination_roots[@]}"; do
    mkdir -p "$root/$name"
    # A destination symlinked back to the canonical copy is already current;
    # cp would refuse to copy a file onto itself and abort the whole run.
    if [ "$(cd "$root/$name" && pwd -P)" = "$(cd "$skill_dir" && pwd -P)" ]; then
      echo "linked    $root/$name"
      continue
    fi
    cp -R "$skill_dir"/. "$root/$name/"
    while IFS= read -r -d '' source_file; do
      COMMANDO_REPO="$repo_root" perl -pi -e 's/\{\{COMMANDO_REPO\}\}/$ENV{COMMANDO_REPO}/g' "$root/$name/${source_file#"$skill_dir"}"
    done < <(grep -rl --null --fixed-strings '{{COMMANDO_REPO}}' "$skill_dir" || true)
    echo "installed $root/$name"
  done
done
