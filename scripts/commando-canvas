#!/usr/bin/env bash
# commando-canvas — register and open an agent canvas beside this tmux pane.
set -euo pipefail

dir=""
manifest="canvas.json"
while [ $# -gt 0 ]; do
  case "$1" in
    --manifest)
      [ $# -ge 2 ] || { echo "commando-canvas: --manifest needs a value" >&2; exit 2; }
      manifest="$2"; shift 2 ;;
    --manifest=*) manifest="${1#--manifest=}"; shift ;;
    -*) echo "commando-canvas: unknown flag $1" >&2; exit 2 ;;
    *)
      [ -z "$dir" ] || { echo "commando-canvas: unexpected argument: $1" >&2; exit 2; }
      dir="$1"; shift ;;
  esac
done
[ -n "$dir" ] || { echo "usage: commando-canvas <dir> [--manifest canvas.json]" >&2; exit 2; }
pane="${TMUX_PANE:-}"
[ -n "$pane" ] || { echo "commando-canvas: not inside a tmux pane (TMUX_PANE is unset)" >&2; exit 1; }
token_file="${COMMANDO_AGENT_HOOK_TOKEN_PATH:-$HOME/.commando/agent-hook-token}"
if [ ! -r "$token_file" ]; then
  echo "commando-canvas: agent hook token not readable at $token_file" >&2
  echo "commando-canvas: run 'npm run hooks:install' in the commando repo first" >&2
  exit 1
fi
dir="$(cd "$dir" 2>/dev/null && pwd)" || { echo "commando-canvas: $dir is not a directory" >&2; exit 1; }
base="http://127.0.0.1:${COMMANDO_PORT:-4310}"
token="$(cat "$token_file")"
body_file=$(mktemp "${TMPDIR:-/tmp}/commando-canvas-body.XXXXXX")
trap 'rm -f "$body_file"' EXIT
request() {
  local status
  status=$(curl -sS -o "$body_file" -w '%{http_code}' -H "Authorization: Bearer ${token}" "$@") || {
    echo "commando-canvas: daemon unavailable at $base" >&2; exit 1;
  }
  case "$status" in
    200|201) ;;
    *) cat "$body_file" >&2; echo "commando-canvas: daemon responded ${status}" >&2; exit 1 ;;
  esac
}
body=$(node -e 'console.log(JSON.stringify({dir:process.argv[1]}))' "$dir")
request -X POST -H 'Content-Type: application/json' --data "$body" "$base/api/redline/artifacts"
artifact_id=$(node -e 'console.log(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).id)' "$body_file")
artifact_url=$(node -e 'console.log(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).url)' "$body_file")
request --get --data-urlencode "manifest=$manifest" "$base/api/redline/artifacts/$artifact_id/canvas"
node -e '
  const result = JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
  const manifest = process.argv[2];
  // Shared parsing names root errors canvas.json even for custom manifests.
  const errors = result.errors.map(error => error.startsWith("canvas.json:") ? manifest + error.slice("canvas.json".length) : error);
  for (const error of errors) console.error("commando-canvas: " + error);
  if (errors.some(error => error.startsWith(manifest + ":"))) process.exit(1);
' "$body_file" "$manifest"
body=$(node -e 'console.log(JSON.stringify({url:process.argv[1],anchor:process.argv[2],engine:"webkit",content:{kind:"canvas",artifactId:process.argv[3],manifest:process.argv[4]}}))' "$artifact_url" "$pane" "$artifact_id" "$manifest")
request -X POST -H 'Content-Type: application/json' --data "$body" "$base/api/web-panes"
node -e 'console.log(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).webPaneId)' "$body_file"
