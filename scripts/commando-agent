#!/usr/bin/env bash
# Runs an agent session in this tmux pane and shows it as a chat in Commando.
#   commando-agent claude [--config-dir ~/.claudep] [--resume ID] [--permission-mode MODE] [--prompt TEXT]
#
# exec keeps the host as the pane's own process, so tmux reports it (not a
# shell) and auto-resume treats the pane as a running agent.
set -euo pipefail
# Follow symlinks by hand: stock macOS readlink has no -f.
script="${BASH_SOURCE[0]}"
while [ -L "$script" ]; do
  link_dir="$(cd -P "$(dirname "$script")" && pwd)"
  script="$(readlink "$script")"
  case "$script" in /*) ;; *) script="$link_dir/$script" ;; esac
done
root="$(cd -P "$(dirname "$script")/.." && pwd)"
export COMMANDO_AGENT_LAUNCHER="$root/scripts/commando-agent"
exec node --import "$root/node_modules/tsx/dist/loader.mjs" "$root/server/agent-host/main.ts" "$@"
