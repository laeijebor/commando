#!/usr/bin/env bash
# commando-feedback — drain one batch of review feedback from a chromium tile.
#
#   commando-feedback <webPaneId> [--wait <seconds>]
#
# Long-polls GET /api/web-panes/<id>/feedback for up to --wait seconds
# (default 30, max 60) and prints the JSON body:
# {"ok":true,"cursor":N,"notes":[...]}.
# Each note carries id, selector, tag, text, rect, comment, pageUrl,
# capturedAt, and optional reviewKey/reviewRevision/response/attachments/handoff.
# Correlate by reviewKey, then deliveryKey, then id; absent reviewRevision means
# baseline revision 1. The highest revision is authoritative; the same revision
# can still update the handoff without repeating the review edit.
# A build handoff asks
# the agent to begin implementation after processing the batch. Fetch any attachment `path`
# with the same bearer token before running this again: the next poll acks the
# prior cursor and releases those bytes. Exit codes: 0 success (notes may be
# empty — just re-run), 4 tile gone (stop polling), 1 other errors.
#
# Delivery is at-least-once: the daemon keeps notes until they are
# acknowledged by passing the previous response's cursor back, which this
# script does automatically via a state file. If a poll response is lost
# (killed task, timeout), just run the script again — the same notes are
# redelivered; dedupe by note id.
set -euo pipefail

pane_id=""
wait_seconds=30
while [ $# -gt 0 ]; do
  case "$1" in
    --wait)
      wait_seconds="${2:-}"
      shift 2 || { echo "commando-feedback: --wait needs a value" >&2; exit 2; }
      ;;
    --wait=*)
      wait_seconds="${1#--wait=}"
      shift
      ;;
    -*)
      echo "commando-feedback: unknown flag $1" >&2
      exit 2
      ;;
    *)
      pane_id="$1"
      shift
      ;;
  esac
done
if [ -z "$pane_id" ]; then
  echo "usage: commando-feedback <webPaneId> [--wait <seconds>]" >&2
  exit 2
fi

token_path="${COMMANDO_AGENT_HOOK_TOKEN_PATH:-$HOME/.commando/agent-hook-token}"
if [ ! -f "$token_path" ]; then
  echo "commando-feedback: agent hook token not found at $token_path" >&2
  exit 1
fi

port="${COMMANDO_PORT:-4310}"
url="http://127.0.0.1:${port}/api/web-panes/${pane_id}/feedback?wait=${wait_seconds}"

# Passing the previous response's cursor back acknowledges those notes; the
# daemon redelivers anything unacked, so a lost response is recoverable.
cursor_dir="${COMMANDO_FEEDBACK_CURSOR_DIR:-$HOME/.commando/feedback-cursors}"
cursor_file="${cursor_dir}/${pane_id}"
if [ -f "$cursor_file" ]; then
  prev_cursor=$(cat "$cursor_file" 2>/dev/null || true)
  case "$prev_cursor" in
    ''|*[!0-9]*) ;;
    *) url="${url}&cursor=${prev_cursor}" ;;
  esac
fi

body_file=$(mktemp "${TMPDIR:-/tmp}/commando-feedback-body.XXXXXX")
trap 'rm -f "$body_file"' EXIT

status=$(curl -sS -o "$body_file" -w '%{http_code}' \
  --max-time "$((wait_seconds + 15))" \
  -H "Authorization: Bearer $(cat "$token_path")" \
  "$url") || { echo "commando-feedback: daemon unreachable" >&2; exit 1; }
body=$(cat "$body_file")
echo "$body"
case "$status" in
  200)
    # The daemon serializes cursor before notes, so the first match is ours,
    # not user text from a comment.
    next_cursor=$(printf '%s' "$body" | grep -o '"cursor":[0-9]*' | head -n1 | cut -d: -f2 || true)
    if [ -n "$next_cursor" ]; then
      mkdir -p -m 700 "$cursor_dir"
      printf '%s' "$next_cursor" > "$cursor_file"
    fi
    exit 0
    ;;
  404)
    rm -f "$cursor_file"
    exit 4
    ;;
  *) echo "commando-feedback: HTTP $status" >&2; exit 1 ;;
esac
