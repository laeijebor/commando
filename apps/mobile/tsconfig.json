{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "types": [
      "jest",
      "expo/types"
    ],
    "paths": {
      "@commando/protocol": [
        "../../shared/protocol.ts"
      ],
      "@/*": [
        "./src/*"
      ],
      "@commando/tmux-create": [
        "../../shared/tmux-create.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../../shared/protocol.ts",
    "../../shared/tmux-create.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
