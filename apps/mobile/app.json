{
  "expo": {
    "name": "Commando",
    "slug": "commando-companion",
    "scheme": "commando",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0c0a14",
    "platforms": ["ios"],
    "ios": {
      "bundleIdentifier": "com.commando.companion",
      "supportsTablet": true,
      "requireFullScreen": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSExceptionDomains": {
            "ts.net": {
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Commando uses the camera to scan the pairing code shown on your Mac.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Commando attaches the photos you pick to a chat message.",
          "cameraPermission": "Commando uses the camera to scan the pairing code shown on your Mac.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c0a14",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "laeijebor",
    "extra": {
      "eas": {
        "projectId": "04c2e655-ec00-46a7-a3e4-01f6e5acb574"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/04c2e655-ec00-46a7-a3e4-01f6e5acb574",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
