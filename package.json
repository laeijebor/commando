{
  "name": "commando",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n daemon,web -c green,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e:terminal": "playwright test e2e/terminal-fidelity.pw.ts --workers=1"
  },
  "dependencies": {
    "@blocknote/ariakit": "^0.51.4",
    "@blocknote/core": "^0.51.4",
    "@blocknote/react": "^0.51.4",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@xterm/headless": "6.0.0",
    "concurrently": "^9.2.0",
    "jsdom": "^27.0.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
