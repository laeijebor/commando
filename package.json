{
  "name": "commando",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n daemon,web -c green,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "hooks:install": "tsx scripts/install-agent-hooks.ts",
    "desktop:dev": "bash scripts/run-desktop-dev.sh",
    "desktop:shell": "bash scripts/run-desktop-dev-app.sh",
    "desktop:test": "swift test --package-path apps/desktop",
    "desktop:build": "bash scripts/build-desktop-app.sh",
    "desktop:install": "bash scripts/install-desktop-app.sh",
    "island:dev": "swift run --package-path apps/island CommandoIsland",
    "island:test": "swift test --package-path apps/island",
    "island:build": "bash scripts/build-island-app.sh",
    "island:install": "bash scripts/install-island-app.sh",
    "spike:native-ui": "vite --config spikes/native-terminal/ui/vite.config.ts",
    "spike:native-ui:build": "tsc -p spikes/native-terminal/ui/tsconfig.json && vite build --config spikes/native-terminal/ui/vite.config.ts",
    "spike:native-swift": "COMMANDO_PORT=${COMMANDO_PORT:-4310} COMMANDO_NATIVE_UI_PORT=${COMMANDO_NATIVE_UI_PORT:-5190} COMMANDO_TOKEN=${COMMANDO_TOKEN:-commando-native-terminal-spike} concurrently -k -n daemon,web,swift -c green,cyan,magenta \"tsx server/index.ts\" \"npm run spike:native-ui\" \"npm run spike:native-swift:shell\"",
    "spike:native-swift:shell": "swift run --package-path spikes/native-terminal/swift NativeTerminalSwiftSpike",
    "spike:native-swift:test": "swift test --package-path spikes/native-terminal/swift",
    "spike:native-tauri": "PATH=\"$HOME/.cargo/bin:/opt/homebrew/opt/rustup/bin:$PATH\" tauri dev --config spikes/native-terminal/tauri/tauri.conf.json",
    "spike:native-tauri:check": "PATH=\"$HOME/.cargo/bin:/opt/homebrew/opt/rustup/bin:$PATH\" cargo check --manifest-path spikes/native-terminal/tauri/Cargo.toml",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e:terminal": "playwright test e2e/terminal-fidelity.pw.ts --workers=1"
  },
  "dependencies": {
    "@blocknote/ariakit": "^0.51.4",
    "@blocknote/core": "^0.51.4",
    "@blocknote/react": "^0.51.4",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@xterm/xterm": "^6.0.0",
    "better-auth": "^1.6.23",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@xterm/headless": "6.0.0",
    "concurrently": "^9.2.0",
    "jsdom": "^27.0.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
